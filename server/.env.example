
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=evoting

PORT=3000

ADMIN_KEY=change_me
ELECTION_SECRET=change_me
NIK_SALT=change_me
FACE_KEY=change_me

ELECTION_SHIFT=7
ELECTION_RAIL=4
BLOCK_SIZE=3

FACE_THRESHOLD=0.5
