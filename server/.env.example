
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=evoting

PORT=3000

ADMIN_KEY=change_me
ADMIN_TOKEN_HASH=
ADMIN_USB_SERIAL=
ELECTION_SECRET=change_me
NIK_SALT=change_me
FACE_KEY=change_me

ELECTION_SHIFT=7
ELECTION_RAIL=4
BLOCK_SIZE=3

FACE_THRESHOLD=0.4
FACE_REGISTER_THRESHOLD=0.35
ALLOW_TAMPER_DEMO=false

NODE_ENV=development

# USB Dongle Enforcement: true = pemilih wajib colok USB berisi dongle .key saat login/sesi
# false = bypass untuk testing tanpa flashdisk
DONGLE_REQUIRED=true
DONGLE_POLL_MS=1500

# Durasi blokir akun sementara (detik) setelah 5x gagal login voter
LOCKOUT_SECONDS=60

# Setup dongle admin: jalankan server (dev mode), buka GET /api/admin/generate-dongle,
# unduh dongle-ADMIN.key ke USB, lalu isi ADMIN_TOKEN_HASH dengan nilai x-token-hash dari response.
# Untuk mendapatkan serial USB admin, jalankan di PowerShell:
#   Get-Disk | Where-Object { $_.BusType -eq 'USB' } | Select-Object FriendlyName, SerialNumber
# Salin nilai SerialNumber ke ADMIN_USB_SERIAL di atas.
# ADMIN_USB_SERIAL wajib diisi di production. Di development, cek serial di-skip (untuk recovery).
